# ==============================================================================
# ASP Private Capital / CTX Bank Pro - Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Production API Security & Authentication Secrets (Required)
# ------------------------------------------------------------------------------
# High-entropy bearer secret for agent graph mutations (must be >= 24 chars, 32 bytes hex recommended)
# Generate via: npm run auth:generate
AGENT_WRITE_TOKEN="generate-a-256-bit-random-secret-via-npm-run-auth:generate"

# High-entropy bearer secret for operator API actions (/api/agents)
CTX_OUTREACH_OPERATOR_TOKEN="generate-a-256-bit-random-secret-via-npm-run-auth:generate"

# Profile access is mandatory. On the first local visit, set up the admin profile
# in the CTX login screen. Hosted deployments should store profiles in the mounted
# CTX_CONFIG_DIR volume or use the Docker admin-password-hash/session-secret files.
CTX_ADMIN_EMAIL="admin@your-company.com"
# Generated by auth:configure-admin; never store the plaintext passkey here.
CTX_ADMIN_PASSWORD_HASH="scrypt:generated-salt:generated-hash"
# Generated by auth:configure-admin; must be at least 32 characters.
CTX_SESSION_SECRET="generated-random-session-signing-secret"

# Asymmetric / Symmetric JWT signing secret for minting operator & agent tokens
CTX_JWT_SECRET="generate-a-256-bit-random-secret-via-npm-run-auth:generate"

# ------------------------------------------------------------------------------
# 2. Email Transport & Mailbox Credentials (Stage #2)
# ------------------------------------------------------------------------------
# Live Gmail / Google Workspace authenticated operator account
GMAIL_USER="operator@aspinvest.co.uk"
GMAIL_APP_PASSWORD="your-app-password-here"

# Set to "true" to enable live external dispatches (defaults to simulation if false)
CTX_LIVE_EMAIL_DISPATCH="false"

# ------------------------------------------------------------------------------
# 3. Model Inference Provider (Stage #1)
# ------------------------------------------------------------------------------
# Enterprise pay-as-you-go model credentials
# GEMINI_API_KEY="AIzaSy..."
# OPENAI_API_KEY="sk-proj-..."
# CTX_OUTREACH_MODEL_KEY=""
# CTX_OUTREACH_MODEL_URL=""

# ------------------------------------------------------------------------------
# 4. LangSmith EU Observability & Tracing
# ------------------------------------------------------------------------------
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"
LANGSMITH_API_KEY="lsv2_pt_..."
LANGSMITH_PROJECT="ctx-local"
LANGSMITH_AGENT_ID="ctx"
LANGSMITH_AGENT_ENVIRONMENT="local"

LANGCHAIN_TRACING_V2="true"
LANGCHAIN_ENDPOINT="https://eu.api.smith.langchain.com"
LANGCHAIN_API_KEY="lsv2_pt_..."
LANGCHAIN_PROJECT="ctx-local"
