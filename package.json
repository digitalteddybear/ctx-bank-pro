{
  "name": "world-creators-knowledge-network",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A live, agent-operable knowledge graph for the World Creators knowledge base.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run lint && npm run qa:docs && npm run qa:netron",
    "ingest": "node --import tsx -e 'import(\"./src/lib/server/lead-corpus.ts\").then(async ({loadLeadGraph}) => console.log((await loadLeadGraph()).nodes.length + \" graph subjects loaded\"))'",
    "qa:leads": "node --import tsx scripts/lead-corpus-qa.ts",
    "qa:outreach": "node --import tsx --test scripts/outreach-qa.ts",
    "qa:benchmark": "node --import tsx scripts/outreach-benchmark.ts",
    "qa:harvest": "node --import tsx --test scripts/harvest-qa.ts",
    "qa:orchestrator": "node --import tsx --test scripts/orchestrator-qa.ts",
    "outreach:demo": "node --import tsx scripts/outreach-runner.ts",
    "outreach:worker": "node --import tsx scripts/outreach-runner.ts --worker",
    "outreach:monitor": "node --import tsx scripts/outreach-monitor.ts",
    "demo": "node --import tsx scripts/live-demo.ts",
    "demo:gmail": "node --import tsx scripts/demo-gmail-thread.ts",
    "demo:send": "node --import tsx scripts/live-email-dispatch.ts",
    "demo:reply": "node --import tsx scripts/live-email-reply.ts",
    "qa:asp": "node scripts/asp-invest-qa.mjs",
    "mcp": "tsx mcp/server.ts",
    "mcp:context": "tsx mcp/restart-context-server.ts",
    "qa:mcp": "node scripts/mcp-qa.mjs",
    "qa:sync": "node scripts/live-sync-qa.mjs",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa:docs": "node scripts/docs-qa.mjs",
    "qa:netron": "node scripts/netron-poc-qa.mjs",
    "qa:api": "node scripts/api-qa.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.1.8",
    "@astryxdesign/theme-neutral": "^0.1.8",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@types/d3-force": "^3.0.10",
    "@types/nodemailer": "^8.0.2",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "fuse.js": "^7.1.0",
    "imapflow": "^2.10.0",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.14.1",
    "mammoth": "^1.12.0",
    "motion": "^12.23.12",
    "next": "^16.2.0",
    "nodemailer": "^10.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "unpdf": "^1.6.2",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.1.8",
    "@next/eslint-plugin-next": "^16.2.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^10.8.0",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11",
    "postcss": "^8.5.22",
    "sharp": "^0.35.3"
  }
}
